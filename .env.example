# Public synthetic demo: no credentials, database, storage or AI.
# Server-only Next.js BFF URL. In local development copy this to apps/web/.env.local.
# On Vercel, set this to the deployed backend HTTPS origin; never NEXT_PUBLIC_*.
BACKEND_URL=http://127.0.0.1:8000

# Guest backend only. Do not expose these through NEXT_PUBLIC_*.
# Without these variables, the synthetic demo still works; guest APIs return 503.
# Use the IPv4 session pooler for Supabase Free. Keep sslmode=require or stronger.
# DATABASE_URL=postgresql://postgres.PROJECT@POOLER_HOST:5432/postgres?sslmode=require
# PGPASSWORD=
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_KEY=
# REVIEW_STORAGE_BUCKET=guest-originals
# FRONTEND_ORIGIN=https://renotrace.vercel.app
# REVIEW_CLEANUP_SECRET= # generate 32+ random characters; same GitHub Actions secret
# REVIEW_WORKER=1
