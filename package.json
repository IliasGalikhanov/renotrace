{
  "name": "renotrace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.1",
  "scripts": {
    "dev": "npm run dev --workspace @renotrace/web",
    "build": "npm run build --workspace @renotrace/web",
    "start": "npm run start --workspace @renotrace/web",
    "typecheck": "npm run typecheck --workspace @renotrace/web && tsc -p tsconfig.e2e.json",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"apps/web/app/**/*.{ts,tsx,css}\" tests/e2e playwright.config.ts tools/e2e-api.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "prettier": "3.10.1"
  }
}
